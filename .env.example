# Used only for the local Chrome profile folder name (not your actual LeetCode password).
USER_EMAIL=your_email_here

# Optional: submission language. Supported values: java, cpp, python3, python, javascript,
# typescript, c, csharp, golang, rust, swift, kotlin, scala, ruby, php, dart, bash, mysql, mssql
# Defaults to java. When set to java and no local solution exists, Leetcoder fetches one online.
PREFERRED_LANGUAGE=java

# Path to your Google Chrome executable.
# Find it at: chrome://version/ -> Executable Path
GOOGLE_CHROME_EXECUTABLE_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
