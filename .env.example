# Used only for the local Chrome profile folder name (not your actual LeetCode password).
USER_EMAIL=madanprasath2007@gmail.com

# Optional: submission language. Supported values: java, cpp, python3, python, javascript,
# typescript, c, csharp, golang, rust, swift, kotlin, scala, ruby, php, dart, bash, mysql, mssql
# Defaults to java. When set to java and no local solution exists, Leetcoder fetches one online.
PREFERRED_LANGUAGE=java

# Path to your Google Chrome executable.
# Find it at: chrome://version/ -> Executable Path
GOOGLE_CHROME_EXECUTABLE_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# Email Notification Configuration (Gmail SMTP)
# For Gmail: create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
NOTIFICATION_EMAIL=recipient_email@gmail.com

# Supabase Cloud Database Configuration (Free PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_secret_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# Google OAuth 2.0 Client ID (For 1-click Sign in with Google)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
